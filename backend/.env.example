# Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase Credentials (obtain from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key
SUPABASE_ANON_KEY=your-supabase-public-anon-key
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret

# Storage Settings
STORAGE_BUCKET_NAME=medical-reports
SIGNED_URL_EXPIRATION_SECONDS=300

# Security Secrets
JWT_SECRET_KEY=change-me-to-a-random-32-byte-hex-string
JWT_ALGORITHM=HS256
