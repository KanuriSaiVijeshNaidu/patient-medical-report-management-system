# Backend Environment Configuration (Template)
ENVIRONMENT=development
PORT=8000
DEBUG=True
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Hosted Supabase Credentials (Project ref: ehprxqjcgrljgswkewgq)
# Obtain from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://ehprxqjcgrljgswkewgq.supabase.co

# Privileged service_role / secret key (BACKEND ONLY - NEVER EXPOSE TO FRONTEND)
# Supports SUPABASE_SERVICE_ROLE_KEY or modern SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-service-role-key

# Public anon / publishable key (optional fallback for backend client)
# Supports SUPABASE_ANON_KEY or modern SUPABASE_PUBLISHABLE_KEY
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Supabase Project JWT Secret (from Supabase Dashboard > Project Settings > API > JWT Settings)
# Required for offline cryptographic HS256 validation.
SUPABASE_JWT_SECRET=your-supabase-project-jwt-secret

# Direct Database Connection (Optional, from Supabase Dashboard > Project Settings > Database)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ehprxqjcgrljgswkewgq.supabase.co:5432/postgres

# Medical Storage & Share Settings
STORAGE_BUCKET_NAME=medical-reports
SIGNED_URL_EXPIRATION_SECONDS=300
MAX_REPORT_FILE_SIZE_BYTES=10485760
DEFAULT_SHARE_EXPIRATION_SECONDS=900
FRONTEND_BASE_URL=http://localhost:3000

# Internal Cryptographic Signing Key (Used for backend-internal state hashing, NOT Supabase JWT)
JWT_SECRET_KEY=change-me-to-a-random-32-byte-hex-string
JWT_ALGORITHM=HS256
